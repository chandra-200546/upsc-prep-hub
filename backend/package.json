{
  "name": "upsc-prep-hub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "migrate": "node ./node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "import:profiles": "node ./node_modules/tsx/dist/cli.mjs src/scripts/import-profiles-csv.ts",
    "migrate:local-to-neon": "node ./node_modules/tsx/dist/cli.mjs src/scripts/migrate-local-to-neon.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.7.4",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
