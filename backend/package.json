{
  "name": "upsc-prep-hub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/index.js",
    "premigrate": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "migrate": "node dist/db/migrate.js",
    "preimport:profiles": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "import:profiles": "node dist/scripts/import-profiles-csv.js",
    "premigrate:local-to-neon": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "migrate:local-to-neon": "node dist/scripts/migrate-local-to-neon.js",
    "start": "node --enable-source-maps dist/index.js",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.7.4",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
